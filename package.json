{
  "name": "json-craft",
  "version": "0.2.1",
  "private": true,
  "description": "A local-first JSON formatter, unescaper and repair workbench.",
  "main": "electron/main.cjs",
  "type": "module",
  "author": "JSON Craft contributors",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "benchmark:json": "node --expose-gc --import tsx scripts/benchmarks/benchmark-json.mts",
    "test": "tsx --test tests/unit/*/*.test.ts",
    "test:e2e": "npm run build && tsx --test --test-concurrency=1 tests/e2e/*/*.test.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir --publish never",
    "dist": "npm run build && electron-builder --publish never",
    "postinstall": "node scripts/patches/patch-codemirror.mjs",
    "predev": "node scripts/patches/patch-codemirror.mjs",
    "predev:web": "node scripts/patches/patch-codemirror.mjs",
    "prebuild": "node scripts/patches/patch-codemirror.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/merge": "6.12.3",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lezer/common": "^1.5.5",
    "@lezer/highlight": "^1.2.5",
    "@uiw/react-codemirror": "^4.25.12",
    "diff": "^9.0.0",
    "i18next": "^26.7.1",
    "jsonc-parser": "^3.3.1",
    "jsonrepair": "^3.15.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.11"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "playwright": "^1.64.1",
    "png2icons": "^2.0.1",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
